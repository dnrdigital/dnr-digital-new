# Production Functions scope: used only by the scheduled refresh.
# Plain local Next.js uses the bundled snapshot without API requests.
# Rotate the previously committed key before setting a replacement.
UNSPLASH_ACCESS_KEY=
# Leave both blank for the three approved search themes.
# Optional: a genuine curated collection ID, or an Unsplash topic ID/slug.
UNSPLASH_COLLECTION_ID=
UNSPLASH_TOPIC_ID=
